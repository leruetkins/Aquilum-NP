<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed background of the adaptive icon: the launcher mask supplies
     the shape, so this is the same #3B82F6 -> #1D4ED8 diagonal gradient as
     aquilum-gpui/assets/app-icon.svg without the rounded corners. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF3B82F6"
                android:endColor="#FF1D4ED8" />
        </aapt:attr>
    </path>
</vector>
